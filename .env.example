# Polymarket Configuration
# Your Ethereum private key (for trading on Polygon)
POLYMARKET_PRIVATE_KEY=your_private_key_here
# Your funder/wallet address
POLYMARKET_FUNDER_ADDRESS=your_wallet_address_here
# Signature type: 0=MetaMask/EOA, 1=Email wallet, 2=Smart contract
POLYMARKET_SIGNATURE_TYPE=0

# API endpoint
POLYMARKET_API_URL=https://clob.polymarket.com

# Risk Controls
MAX_POSITION_SIZE_USD=100
DAILY_LOSS_LIMIT_USD=50
MAX_SINGLE_TRADE_USD=20
MIN_ARBITRAGE_SPREAD=0.02

# Server
HOST=0.0.0.0
PORT=8888
